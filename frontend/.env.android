# ── Android / Capacitor build environment ─────────────────────────────────────
#
# Loaded automatically by Vite when building with --mode android.
# Values here OVERRIDE the corresponding keys in .env for the Android bundle.
#
# Why this file exists:
#   The web build (Vercel) uses a RELATIVE API path (/api/v1) because Vercel's
#   vercel.json rewrites /api/v1/* → https://kanaku-api.onrender.com/api/*.
#   But the Capacitor native webview has NO proxy — it serves from
#   capacitor://localhost, so relative paths resolve to capacitor://localhost/api/v1
#   instead of the real backend. This file provides the full absolute URL for
#   native Android (and iOS) builds.
#
# Usage:
#   Automatically used by: npm run mobile:build:android
#                          npm run mobile:aab:play
#                          npm run mobile:aab:full
#   Manual:  cd frontend && vite build --mode android

VITE_API_URL=https://kanaku-api.onrender.com/api/v1
VITE_API_BASE_URL=https://kanaku-api.onrender.com/api/v1
VITE_SOCKET_URL=https://kanaku-api.onrender.com
VITE_APP_ENV=production
VITE_ENABLE_REALTIME=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_DEMO_DATA=false

# Supabase (public anon key + public project URL -- both are designed to ship
# in the client bundle). Present in .env.ios but not here, so the two mobile
# builds were configured differently for no reason. src/utils/supabase/client.ts
# hardcodes the same values as a fallback, so this was not breaking Android --
# it just meant the fallback silently carried Android while iOS used the env.
VITE_SUPABASE_URL=https://mmwrckfqeqjfqciymemh.supabase.co
