      "id": 1,
      "title": "Ledger Post Volume & Rates",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(rate(ledger_post_total[5m]))",
          "legendFormat": "Posts/sec",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(rate(ledger_post_failed_total[5m])) by (reason)",
          "legendFormat": "Failed Post [{{reason}}]",
          "range": true,
          "refId": "B"
        }
      ]
    },
