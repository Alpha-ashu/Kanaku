// ─── Recurring Transactions (Subscriptions & Bills) ────────────────────────────

model RecurringTransaction {
  id                  String               @id @default(uuid())
  userId              String
  title               String
  amount              Decimal              @db.Decimal(12, 2)
  category            String
  subcategory         String?
  interval            String               @default("monthly") // weekly, monthly, yearly
  nextDueDate         DateTime
  autoProcess         Boolean              @default(false)
  status              String               @default("active") // active, paused, cancelled
  accountId           String?
  description         String?
  merchant            String?
  lastProcessedAt     DateTime?
  // Global unique index from 00000000000000_init, kept deliberately (owner
  // decision, 2026-09-20) alongside the per-user index below, which is the one
  // the code relies on. Declared here so schema and migrations agree.
  clientRequestId     String? @unique(map: "recurring_transactions_clientRequestId_key")
  syncStatus          String               @default("synced")
  // ─── Extended fields (schema alignment with Dexie client) ───
  type                String? // income | expense | transfer
  startDate           DateTime?
  endDate             DateTime?
  reminderDaysBefore  Int?
  notes               String?
  transferToAccountId String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  executions          RecurringExecution[]

  @@unique([userId, clientRequestId])
  @@index([userId])
  @@index([status])
  @@index([nextDueDate])
  @@index([status, nextDueDate])
  @@index([syncStatus])
  @@index([deletedAt])
  @@map("recurring_transactions")
  @@schema("public")
}

// ─── Budgets & Budget Alerts ───────────────────────────────────────────────────

model Budget {
  id              String    @id @default(uuid())
  userId          String
  category        String
  amount          Decimal   @db.Decimal(12, 2)
  spent           Decimal   @default(0) @db.Decimal(12, 2)
  period          String    @default("monthly") // weekly, monthly, yearly
  threshold       Int       @default(80) // Alert percentage threshold (0-100)
  startDate       DateTime?
  endDate         DateTime?
  alertEnabled    Boolean   @default(true)
  alertChannels   Json      @default("[\"app\"]") // ["app", "email", "push"]
  // Global unique kept deliberately (owner decision, 2026-09-20), with the
  // per-user index below — the one the code relies on — added alongside it so
  // this table matches Account/Goal/Loan/Investment/RecurringTransaction. The
  // global index alone made a client-generated id collide across tenants.
  clientRequestId String?   @unique(map: "budgets_clientRequestId_key")
  syncStatus      String    @default("synced")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientRequestId])
  @@unique([userId, category, period])
  @@index([userId])
  @@index([category])
  @@index([period])
  @@index([syncStatus])
  @@index([deletedAt])
  @@map("budgets")
  @@schema("public")
}

