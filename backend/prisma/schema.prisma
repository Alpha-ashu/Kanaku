// Unified participant/invitation tracking shared by Group Expenses, Together
// To-Do Lists, Together Goals, and future collaborative modules. Module-specific
// tables (GroupExpenseMember, todo_list_shares, GoalMember) still hold the
// feature-specific data (share amounts, permissions, etc); this table only
// tracks invitation/registration state and lets a single service drive
// notifications, invitation emails, and deferred auto-linking on signup.
model CollaborationParticipant {
  id            String    @id @default(uuid())
  moduleType    String // 'group_expense' | 'todo_list' | 'goal' | 'loan'
  moduleId      String
  moduleName    String? // snapshot of the title at invite time, for emails
  email         String?
  phone         String?
  name          String?
  userId        String? // set once resolved/linked to a registered user
  friendId      String? // links to the Friend record if available
  status        String    @default("PENDING_REGISTRATION") // REGISTERED | PENDING_REGISTRATION | PENDING_CONTACT
  invitedBy     String
  metadata      Json?     // snapshot details (share amount, due date, etc.)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  linkedAt      DateTime?
  user          User?     @relation("CollaborationParticipant_user", fields: [userId], references: [id], onDelete: SetNull)
  invitedByUser User      @relation("CollaborationParticipant_invitedBy", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([phone])
  @@index([friendId])
  @@index([status])
  // From 00000000000000_init, kept deliberately (owner decision, 2026-09-20).
  // NULL emails stay distinct, so phone-only invites are unaffected.
  @@unique([moduleType, moduleId, email], map: "CollaborationParticipant_moduleType_moduleId_email_key")
  @@index([moduleType, moduleId])
  @@index([userId])
  @@index([invitedBy])
  @@schema("public")
}

