  canDownload      Boolean        @default(true) @map("can_download")
  grantedAt        DateTime       @default(now()) @map("granted_at")
  revokedAt        DateTime?      @map("revoked_at")
  expiresAt        DateTime?      @map("expires_at")

  owner            User           @relation("VaultShare_owner", fields: [ownerId], references: [id], onDelete: Cascade)
  sharedWithUser   User           @relation("VaultShare_recipient", fields: [sharedWithUserId], references: [id], onDelete: Cascade)
  document         VaultDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  folder           VaultFolder?   @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([sharedWithUserId])
  @@index([documentId])
  @@index([folderId])
  @@index([status])
  @@map("vault_shares")
  @@schema("public")
}

model VaultAuditLog {
  id         String         @id @default(uuid())
  ownerId    String         @map("owner_id")
  actorId    String         @map("actor_id")
  documentId String?        @map("document_id")
  folderId   String?        @map("folder_id")
  action     String         // UPLOAD | VIEW | DOWNLOAD | UPDATE | DELETE | FOLDER_CREATE | FOLDER_RENAME | FOLDER_DELETE | SHARE_GRANT | SHARE_REVOKE | PERMISSION_CHANGE | ACCESS_DENIED
  details    String?        // JSON or summary description
  ipAddress  String?        @map("ip_address")
  userAgent  String?        @map("user_agent")
  createdAt  DateTime       @default(now()) @map("created_at")

  owner      User           @relation("VaultAuditLog_owner", fields: [ownerId], references: [id], onDelete: Cascade)
  actor      User           @relation("VaultAuditLog_actor", fields: [actorId], references: [id], onDelete: Cascade)
  document   VaultDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  folder     VaultFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([actorId])
  @@index([documentId])
  @@index([folderId])
  @@index([action])
  @@index([createdAt])
  @@map("vault_audit_logs")
  @@schema("public")
}

