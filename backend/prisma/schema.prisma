// Append-only activity trail for EVERY mutating action, written centrally by the
// audit interceptor in src/db/prisma.ts (so API, sync, workers and scripts are all
// covered) plus the explicit `audit()` calls in src/utils/auditLogger.ts.
// Immutability is enforced in the DB by the `auditlog_immutable` trigger — see
// migration 20260920020000_audit_coverage_and_integrity.
model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  // Role the actor held when the action ran. Denormalised on purpose: roles
  // change over time and an audit row must stay true to the moment it recorded,
  // and it makes "what did every manager do" a plain indexed scan rather than a
  // join against the User table's *current* role.
  actorRole String?
  action    String
  // `resource` stays as the human-readable "Model:id" string every existing row
  // and dashboard already uses. resourceType/resourceId are the queryable split
  // of the same value — previously answering "every action on transaction X"
  // needed a LIKE over `resource`.
  resource     String
  resourceType String?
  resourceId   String?
  status    String
  ip        String?
  userAgent String?
  requestId String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([requestId])
  @@index([userId, createdAt]) // per-user activity feed, newest first
  @@index([resourceType, resourceId]) // full history of one record
  @@index([action]) // "all deletes", "all role changes"
  @@index([actorRole, createdAt]) // per-role activity reporting
  @@schema("public")
}

