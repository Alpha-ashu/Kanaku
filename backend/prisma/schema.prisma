model VaultFolder {
  id          String          @id @default(uuid())
  userId      String          @map("user_id")
  parentId    String?         @map("parent_id")
  name        String
  category    String          @default("Personal Documents")
  isDefault   Boolean         @default(false) @map("is_default")
  color       String?
  icon        String?
  // Idempotency key. The route guard is in-memory only (single instance, Redis
  // off), so it stops a double-tap but not a retry that lands after a restart or
  // on another instance. This is the durable backstop.
  clientRequestId String?   @map("client_request_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  deletedAt   DateTime?       @map("deleted_at")

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent      VaultFolder?    @relation("VaultFolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subfolders  VaultFolder[]   @relation("VaultFolderHierarchy")
  documents   VaultDocument[]
  shares      VaultShare[]
  auditLogs   VaultAuditLog[]

  @@unique([userId, clientRequestId])
  @@index([userId])
  @@index([parentId])
  @@index([category])
  @@map("vault_folders")
  @@schema("public")
}

model VaultDocument {
  id               String                 @id @default(uuid())
  userId           String                 @map("user_id")
  folderId         String?                @map("folder_id")
  title            String
  originalFileName String                 @map("original_file_name")
  fileType         String                 @map("file_type")
  fileSize         Int                    @map("file_size")
  storagePath      String                 @map("storage_path")
  isEncrypted      Boolean                @default(true) @map("is_encrypted")
  encryptionIv     String?                @map("encryption_iv")
  description      String?
  tags             String[]               @default([])
  category         String                 @default("Personal Documents")
  institution      String?
  documentNumber   String?                @map("document_number")
  expiryDate       DateTime?              @map("expiry_date")
  renewalDate      DateTime?              @map("renewal_date")
  reminderDate     DateTime?              @map("reminder_date")
  currentVersion   Int                    @default(1) @map("current_version")
  isSensitive      Boolean                @default(false) @map("is_sensitive")
  // See VaultFolder.clientRequestId.
  clientRequestId  String?                @map("client_request_id")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  deletedAt        DateTime?              @map("deleted_at")

  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder           VaultFolder?           @relation(fields: [folderId], references: [id], onDelete: SetNull)
  versions         VaultDocumentVersion[]
  shares           VaultShare[]
  auditLogs        VaultAuditLog[]

  @@unique([userId, clientRequestId])
  @@index([userId])
  @@index([folderId])
  @@index([category])
  @@index([expiryDate])
  @@map("vault_documents")
  @@schema("public")
}

model VaultDocumentVersion {
  id            String        @id @default(uuid())
  documentId    String        @map("document_id")
  versionNumber Int           @map("version_number")
  fileName      String        @map("file_name")
  storagePath   String        @map("storage_path")
  fileSize      Int           @map("file_size")
  fileType      String        @map("file_type")
  uploadedBy    String        @map("uploaded_by")
  note          String?
  createdAt     DateTime      @default(now()) @map("created_at")

  document      VaultDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@map("vault_document_versions")
  @@schema("public")
}

model VaultShare {
  id               String         @id @default(uuid())
  ownerId          String         @map("owner_id")
