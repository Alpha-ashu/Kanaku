generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // url / directUrl removed for Prisma 7 — see backend/prisma.config.ts (CLI)
  // and src/db/prisma.ts (runtime, via PrismaPg adapter).
  schemas  = ["public"]
}

model Account {
  id                String             @id @default(uuid())
  userId            String
  deviceId          String?
  name              String
  type              String             @default("bank")
  provider          String?
  country           String?
  openingBalance    Decimal            @default(0) @db.Decimal(12, 2) // Starting balance; Current = openingBalance + ledger
  balance           Decimal            @default(0) @db.Decimal(12, 2) // Maintained as openingBalance + Σ(transaction deltas)
  currency          String             @default("INR")
  isActive          Boolean            @default(true)
  syncStatus        String             @default("synced")
  // Global unique index from 00000000000000_init, kept deliberately (owner
  // decision, 2026-09-20) alongside the per-user index below, which is the one
  // the code relies on. Declared here so schema and migrations agree.
  clientRequestId   String? @unique(map: "Account_clientRequestId_key")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalContributions GoalContribution[]
  transactions      Transaction[]
  groupExpenses     GroupExpense[]

  @@unique([userId, clientRequestId])
  @@index([isActive])
  @@index([syncStatus])
  @@index([userId])
  @@index([createdAt])
  @@index([deletedAt])
  @@schema("public")
}

model AdvisorApplication {
  id                  String    @id @default(uuid())
  userId              String    @unique
  fullName            String
  email               String
  phone               String
  experienceYears     Int
  expertise           String
  organizationName    String?
  bio                 String
  /// Consultation fee per hour, in the platform currency. Nullable: advisors
  /// approved before the field existed have no rate until they set one, and the
  /// booking screen shows "fee on request" rather than inventing a number.
  hourlyRate          Decimal?  @db.Decimal(10, 2)
  panDocumentPath     String?
  aadhaarDocumentPath String?
  certDocumentPath    String?
  status              String    @default("PENDING")
  rejectionReason     String?
  reviewedBy          String?
  reviewedAt          DateTime?
  submittedAt         DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation("AdvisorApplication_user", fields: [userId], references: [id], onDelete: Cascade)
  reviewer            User?     @relation("AdvisorApplication_reviewer", fields: [reviewedBy], references: [id])

  @@index([status])
  @@index([userId])
  @@index([reviewedBy])
  @@schema("public")
}

model AdvisorAvailability {
  id        String   @id @default(uuid())
  advisorId String
  dayOfWeek Int
  startTime String
  endTime   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  advisor   User     @relation(fields: [advisorId], references: [id], onDelete: Cascade)

  /// One row per advisor per weekday: setAvailability does a
  /// find-by-(advisorId, dayOfWeek)-then-update-or-create, and the bulk
  /// seeder writes exactly one slot per day. The constraint makes that
  /// compare-and-set race-proof instead of merely usually-correct.
  @@unique([advisorId, dayOfWeek])
  @@index([advisorId])
  @@schema("public")
}

model AdvisorSession {
  id           String         @id @default(uuid())
  bookingId    String         @unique
  advisorId    String
  clientId     String
  startTime    DateTime
  endTime      DateTime?
  sessionType  String
  status       String         @default("scheduled")
  notes        String?
  rating       Float?
  feedback     String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  advisor      User           @relation("AdvisorSession_advisorIdToUser", fields: [advisorId], references: [id], onDelete: Cascade)
  booking      BookingRequest @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  client       User           @relation("AdvisorSession_clientIdToUser", fields: [clientId], references: [id], onDelete: Cascade)
  chatMessages ChatMessage[]
  payment      Payment?

  @@index([advisorId])
  @@index([clientId])
  @@index([startTime])
  @@index([status])
  @@schema("public")
}

model BookingRequest {
  id              String          @id @default(uuid())
  clientId        String
  advisorId       String
  sessionType     String
  description     String?
  proposedDate    DateTime
  proposedTime    String
  duration        Int
  amount          Decimal         @db.Decimal(12, 2)
  /// pending | accepted | rejected | reschedule | completed | cancelled
  /// `reschedule` means a new time has been PROPOSED and is awaiting the other
  /// party's answer. Deliberately not renamed to `reschedule_proposed`: live
  /// rows and shipped clients already use this spelling.
  status          String          @default("pending")
  rejectionReason String?
  /// ── Reschedule negotiation ────────────────────────────────────────────────
  /// Added 2026-09-24. The advisor could put a booking into `reschedule`, but
  /// no endpoint let the client answer, so the booking dead-ended there: it
  /// could only be cancelled. These four give the proposal an author, its own
  /// message field (it was being stuffed into `rejectionReason`), a bound on
  /// how many times the two sides may volley, and an expiry so an unanswered
  /// proposal does not hold a slot forever.
  /// All nullable / defaulted: existing rows read as "no proposal outstanding".
  rescheduleCount Int             @default(0)
  /// userId of whoever proposed the time currently on the row.
  rescheduleProposedBy String?
  rescheduleMessage    String?
  rescheduleExpiresAt  DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  session         AdvisorSession?
  advisor         User            @relation("BookingRequest_advisorIdToUser", fields: [advisorId], references: [id], onDelete: Cascade)
  client          User            @relation("BookingRequest_clientIdToUser", fields: [clientId], references: [id], onDelete: Cascade)
  /// Idempotency key for creates. The in-memory duplicateSubmitGuard stops a
  /// double-tap on one instance until restart; this is the durable backstop.
  clientRequestId String?

  @@unique([clientId, clientRequestId])
  @@index([advisorId])
  @@index([clientId])
  @@index([proposedDate])
  @@index([status])
  @@schema("public")
}

model Category {
  id                String    @id @default(uuid())
  userId            String
  name              String
  type              String
  color             String
  icon              String
  createdFromImport Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name, type])
  @@index([type])
  @@index([userId])
  @@schema("public")
}

model ChatMessage {
  id        String         @id @default(uuid())
  sessionId String
  senderId  String
  message   String
  timestamp DateTime       @default(now())
  /// Storage object key for a file shared in the thread. Never a public URL —
  /// the object is private and reached through a short-lived signed URL issued
  /// per request, so a leaked message row does not leak the document.
  attachmentPath String?
  attachmentName String?
  attachmentType String?
  attachmentSize Int?
  sender    User           @relation(fields: [senderId], references: [id], onDelete: Cascade)
  session   AdvisorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// Idempotency key for creates. The in-memory duplicateSubmitGuard stops a
  /// double-tap on one instance until restart; this is the durable backstop.
  clientRequestId String?

  @@unique([senderId, clientRequestId])
  @@index([senderId])
  @@index([sessionId])
  @@index([timestamp])
  @@schema("public")
}

/// A published update from an advisor — the content behind the Discover and
/// Following feeds.
model AdvisorPost {
  id        String            @id @default(uuid())
  advisorId String
  category  String
  title     String
  content   String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  deletedAt DateTime?
  advisor   User              @relation("AdvisorPost_advisor", fields: [advisorId], references: [id], onDelete: Cascade)
  likes     AdvisorPostLike[]
  /// Idempotency key for creates. The in-memory duplicateSubmitGuard stops a
  /// double-tap on one instance until restart; this is the durable backstop.
  clientRequestId String?

  @@unique([advisorId, clientRequestId])
  @@index([advisorId])
  @@index([createdAt])
  @@schema("public")
}

model AdvisorPostLike {
  id        String      @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime    @default(now())
  post      AdvisorPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User        @relation("AdvisorPostLike_user", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
  @@schema("public")
}

model AdvisorFollow {
  id         String   @id @default(uuid())
  advisorId  String
  followerId String
  createdAt  DateTime @default(now())
  advisor    User     @relation("AdvisorFollow_advisor", fields: [advisorId], references: [id], onDelete: Cascade)
  follower   User     @relation("AdvisorFollow_follower", fields: [followerId], references: [id], onDelete: Cascade)

  @@unique([advisorId, followerId])
  @@index([followerId])
  @@schema("public")
}

model Device {
  id           String    @id @default(uuid())
  userId       String
  deviceId     String    @unique
  deviceName   String?
  deviceType   String?
  platform     String?
  appVersion   String?
  isActive     Boolean   @default(true)
  isTrusted    Boolean   @default(false)
  lastSeenAt   DateTime  @default(now())
  // Notification System Fields
  fcmToken     String? // Firebase Cloud Messaging token for push notifications
  publicKey    String? // Optional public key for E2E encryption (TweetNaCl format)
  osType       String?
  osVersion    String?
  apnsToken    String?
  lastSyncedAt DateTime? @default(now())
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId], name: "userId_deviceId")
  @@index([deviceId])
  @@index([isActive])
  @@index([userId])
  @@index([fcmToken])
  @@index([userId, isActive]) // active device lookup for push notifications
  @@schema("public")
}

model ExpenseBill {
  id               String   @id @default(uuid())
  userId           String
  transactionId    String?
  originalName     String
  contentType      String
  size             Int
  storagePath      String
  sha256           String
  scanStatus       String   @default("pending")
  scanResult       String?
  moderationStatus String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Idempotency key for creates. The in-memory duplicateSubmitGuard stops a
  /// double-tap on one instance until restart; this is the durable backstop.
  clientRequestId  String?

  @@unique([userId, clientRequestId])
  @@index([sha256])
  @@index([transactionId])
  @@index([userId])
  @@schema("public")
}

model Friend {
  id                  String               @id @default(uuid())
  userId              String
  deviceId            String?
  name                String
  email               String?
  phone               String?
  avatar              String?
  notes               String?
  syncStatus          String               @default("synced")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupExpenseMembers GroupExpenseMember[]
  /// Idempotency key for creates. The in-memory duplicateSubmitGuard stops a
  /// double-tap on one instance until restart; this is the durable backstop.
  clientRequestId     String?

  @@unique([userId, clientRequestId])
  @@index([syncStatus])
  @@index([userId])
  @@schema("public")
}

model Goal {
  id                String             @id @default(uuid())
  userId            String
  deviceId          String?
  name              String
  description       String?
  targetAmount      Decimal            @db.Decimal(12, 2)
  currentAmount     Decimal            @default(0) @db.Decimal(12, 2)
  targetDate        DateTime
  category          String?
  isGroupGoal       Boolean            @default(false)
  syncStatus        String             @default("synced")
  // Global unique index from 00000000000000_init, kept deliberately (owner
  // decision, 2026-09-20) alongside the per-user index below, which is the one
  // the code relies on. Declared here so schema and migrations agree.
  clientRequestId   String? @unique(map: "Goal_clientRequestId_key")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalContributions GoalContribution[]
  goalMembers       GoalMember[]

  @@unique([userId, clientRequestId])
  @@index([syncStatus])
  @@index([targetDate])
  @@index([userId])
  @@index([createdAt])
  @@index([deletedAt])
  @@schema("public")
}

model GoalContribution {
  id         String   @id @default(uuid())
  userId     String
  goalId     String
  accountId  String
  amount     Decimal  @db.Decimal(12, 2)
  date       DateTime
  memberName String?
  status     String?
  notes      String?
  // Idempotency key — a retried contribution used to debit the account twice.
  clientRequestId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  goal       Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientRequestId])
  @@index([accountId])
  @@index([date])
  @@index([goalId])
  @@index([userId])
  @@schema("public")
}

model ImportLog {
  id                String   @id @default(uuid())
  userId            String
  fileName          String
  fileType          String
  sourceKind        String
  totalRecords      Int
  importedRecords   Int
  skippedRecords    Int
  duplicateRecords  Int
  createdCategories Json     @default("[]")
  createdAccounts   Json     @default("[]")
  createdGoals      Json     @default("[]")
  updatedGoals      Json     @default("[]")
  failedRecords     Int      @default(0)
  errors            Json     @default("[]")
  metadata          String?
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([sourceKind])
  @@index([userId])
  @@schema("public")
}

model Investment {
  id                  String    @id @default(uuid())
  userId              String
  assetType           String
  assetName           String
  quantity            Decimal   @db.Decimal(12, 4)
  buyPrice            Decimal   @db.Decimal(12, 2)
  currentPrice        Decimal   @db.Decimal(12, 2)
  // Derived columns. NOT database-computed — an earlier comment here claimed a
  // trigger maintained them, but no migration ever created one and the client
  // could post any value it liked. They are now computed server-side on every
  // write (investment.controller.ts) and any client-supplied value is ignored.
  totalInvested       Decimal   @db.Decimal(12, 2) // = quantity * buyPrice
  currentValue        Decimal   @db.Decimal(12, 2) // = quantity * currentPrice
  profitLoss          Decimal   @db.Decimal(12, 2) // = currentValue - totalInvested
  purchaseDate        DateTime
  lastUpdated         DateTime
  metadata            Json?
  // Global unique index from 00000000000000_init, kept deliberately (owner
  // decision, 2026-09-20) alongside the per-user index below, which is the one
  // the code relies on. Declared here so schema and migrations agree.
  clientRequestId     String? @unique(map: "Investment_clientRequestId_key")
  // ─── Extended fields (schema alignment with Dexie client) ───
  broker              String?
  description         String?
  assetCurrency       String?
  baseCurrency        String?
  buyFxRate           Decimal?  @db.Decimal(18, 8)
  lastKnownFxRate     Decimal?  @db.Decimal(18, 8)
  totalInvestedNative Decimal?  @db.Decimal(18, 2)
  currentValueNative  Decimal?  @db.Decimal(18, 2)
  valuationVersion    Int?
  positionStatus      String?   @default("open") // open | closed
  closedAt            DateTime?
  closePrice          Decimal?  @db.Decimal(18, 2)
  closeFxRate         Decimal?  @db.Decimal(18, 8)
  grossSaleValue      Decimal?  @db.Decimal(18, 2)
  netSaleValue        Decimal?  @db.Decimal(18, 2)
  purchaseFees        Decimal?  @db.Decimal(18, 2)
  closingFees         Decimal?  @db.Decimal(18, 2)
  realizedProfitLoss  Decimal?  @db.Decimal(18, 2)
  closeNotes          String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientRequestId])
  @@index([assetType])
  @@index([userId])
  @@index([deletedAt])
  @@index([positionStatus])
  @@schema("public")
}

model Loan {
  id                 String        @id @default(uuid())
  userId             String
  deviceId           String?
  type               String
  name               String
  principalAmount    Decimal       @db.Decimal(12, 2)
  // Derived column. NOT database-computed — the trigger this comment used to
  // claim never existed in any migration, and `outstandingBalance` sat in the
  // update allow-list, so a client could set it directly. It is now maintained
  // server-side only (loan.controller.ts) from principalAmount - Σ(payments).
  outstandingBalance Decimal       @db.Decimal(12, 2)
  interestRate       Decimal?      @db.Decimal(12, 2)
  emiAmount          Decimal?      @db.Decimal(12, 2)
  dueDate            DateTime?
  frequency          String?
  status             String        @default("active")
  contactPerson      String?
  syncStatus         String        @default("synced")
  // Global unique index from 00000000000000_init, kept deliberately (owner
  // decision, 2026-09-20) alongside the per-user index below, which is the one
  // the code relies on. Declared here so schema and migrations agree.
  clientRequestId    String? @unique(map: "Loan_clientRequestId_key")
  // ─── Extended fields (schema alignment with Dexie client) ───
  totalPayable       Decimal?      @db.Decimal(12, 2)
  loanDate           DateTime?
  contactEmail       String?
  contactPhone       String?
  bankName           String?
  tenureMonths       Int?
  downPayment        Decimal?      @db.Decimal(12, 2)
  loanCategory       String?
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments           LoanPayment[]

  @@unique([userId, clientRequestId])
  @@index([dueDate])
  @@index([status])
  @@index([syncStatus])
  @@index([userId])
  @@index([createdAt])
  @@index([deletedAt])
  @@schema("public")
}

model LoanPayment {
  id        String    @id @default(uuid())
  loanId    String
  // Owner, denormalised from Loan.userId. Every other money table carries the
  // owner directly (GoalContribution does); without it a per-user query on
  // repayments had to join through Loan, and no userId filter could catch a
  // mis-scoped one. Backfilled from the parent loan in
  // 20260920020000_audit_coverage_and_integrity.
  userId    String
  amount    Decimal   @db.Decimal(12, 2)
  accountId String?
  date      DateTime
  notes     String?
  // Idempotency key for repayment posting — a double-tapped EMI used to create
  // two rows because no dedup layer reached this table.
  clientRequestId String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime? // Added for soft-delete consistency
  loan      Loan      @relation(fields: [loanId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientRequestId])
  @@index([date])
  @@index([loanId])
  @@index([userId])
  @@index([deletedAt])
  @@schema("public")
}

model Notification {
  id               String    @id @default(uuid())
  userId           String
  sourceUserId     String? // User who triggered the notification (for group messages, friend requests, etc.)
  title            String
  message          String
  type             String    @default("info") // friend_request, group_expense, loan_reminder, etc.
  category         String?
  deepLink         String?
  priority         String    @default("normal") // high, normal, low
  channels         Json      @default("[\"app\"]") // JSON array: ["app", "email", "push"]
  requestId        String? // Correlation ID from the originating API request (propagated to worker delivery audits)
  metadata         Json?
  // Multi-channel Delivery Tracking
  deliveryStatus   Json      @default("{}") // JSON: {app: sent, email: queued, push: failed}
  encryptedPayload String? // Optional encrypted payload (if E2E encryption enabled)
  isRead           Boolean   @default(false)
  createdAt        DateTime  @default(now())
  readAt           DateTime?
  deletedAt        DateTime? // Soft-delete for compliance
  // ── Queue-backed delivery lifecycle (PostgreSQL is the source of truth) ──
  // Overall delivery state; per-channel truth stays in `deliveryStatus`. These
  // power retries, dead-letter recovery and observability.
  // App-only notifications are delivered the moment the row exists, so they rest
  // at 'sent'. The dispatcher explicitly sets 'pending' only when it enqueues an
  // async channel (email/push); a worker then drives retrying → sent | failed.
  status           String    @default("sent") // pending|processing|retrying|sent|failed
  attempts         Int       @default(0)
  nextRetryAt      DateTime?
  errorMessage     String?
  sentAt           DateTime?
  updatedAt        DateTime  @default(now()) @updatedAt
  // ── Dedup key for budget alerts ──────────────────────────────────────────
  // Format: "<userId>:<type>:<category>:<periodKey>" e.g. "abc:budget_alert:Groceries:2026-08-monthly"
  // A unique index on this field prevents the same threshold crossing from
  // generating duplicate alert rows even when the listener fires concurrently.
  // NULL means dedup is not applicable (all non-budget-alert notification types).
  dedupKey         String?   @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([isRead])
  @@index([userId])
  @@index([sourceUserId])
  @@index([type])
  @@index([deletedAt])
  @@index([userId, isRead, createdAt]) // unread notification counts + sorted feed
  @@index([status, nextRetryAt]) // retry sweeper / stuck-delivery recovery
  @@schema("public")
}

model Payment {
  id            String         @id @default(uuid())
  // One payment per session. Deliberate: a session is paid for once. A refund
  // does NOT free the slot — the refunded row stays and is the audit record, so
  // re-paying a refunded session is a new session, not a second Payment here.
  sessionId     String         @unique
  clientId      String
  advisorId     String
  amount        Decimal        @db.Decimal(12, 2)
  currency      String         @default("INR")
  status        String         @default("pending")
  paymentMethod String?
  transactionId String?        @unique
  description   String?
  // Idempotency key for initiation. The refund route already has a route-level
  // idempotency guard; the row itself carried no key, so a replayed initiate
  // could only be caught by the sessionId unique (a 500, not a replay).
  clientRequestId String?
  // Refund / completion audit. The refund reason previously existed only in the
  // notification text, so the row could not say when or why it was refunded.
  completedAt   DateTime?
  refundedAt    DateTime?
  refundReason  String?
  failureReason String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  advisor       User           @relation("Payment_advisorIdToUser", fields: [advisorId], references: [id], onDelete: Cascade)
  client        User           @relation("Payment_clientIdToUser", fields: [clientId], references: [id], onDelete: Cascade)
  session       AdvisorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([clientId, clientRequestId])
  @@index([advisorId])
  @@index([clientId])
  @@index([createdAt])
  @@index([status])
  @@schema("public")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("public")
}

model SyncQueue {
  id             String    @id @default(uuid())
  userId         String
  deviceId       String?
  entityType     String // transaction, group, friend, goal, etc.
  entityId       String
  operation      String? // create, update, delete
  action         String?
  sourceDeviceId String?
  metadata       Json?
  data           Json? // JSON payload (was String? – changed to Json for type safety)
  status         String    @default("pending") // pending, processing, synced, failed
  errorMessage   String?
  retryCount     Int       @default(0)
  maxRetries     Int       @default(3) // Auto-fail after 3 retries
  processingTime Int? // Time in milliseconds to process
  createdAt      DateTime  @default(now())
  processedAt    DateTime?

  @@index([createdAt])
  @@index([deviceId])
  @@index([entityType])
  @@index([status])
  @@index([userId])
  @@schema("public")
}

model Todo {
  id        String   @id @default(uuid())
  title     String
