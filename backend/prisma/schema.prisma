enum RecurringExecutionStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  RETRYING
  SKIPPED

  @@schema("public")
}

model RecurringExecution {
  id            String                   @id @default(uuid())
  ruleId        String
  scheduledDate DateTime
  executedDate  DateTime?
  journalId     String?
  // transactionId links back to the Transaction row that this execution created.
  // Allows financial reconciliation: every RecurringExecution.SUCCESS must have
  // exactly one matching Transaction. NULL until the execution completes.
  transactionId String?
  status        RecurringExecutionStatus @default(PENDING)
  failureReason String?
  retryCount    Int                      @default(0)
  nextRetryAt   DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  rule          RecurringTransaction     @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  // The @@unique constraint on (ruleId, scheduledDate) is the PRIMARY idempotency
  // gate for the recurring worker. If the scheduler fires twice for the same
  // occurrence, the second upsert will hit this constraint and safely skip.
  @@unique([ruleId, scheduledDate])
  @@index([ruleId])
  @@index([status])
  @@index([scheduledDate])
  @@index([transactionId])
  @@map("recurring_executions")
  @@schema("public")
}

model JournalEntry {
