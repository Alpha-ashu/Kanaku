# Template for backend/.env.test — copy to backend/.env.test and fill in values.
# NEVER commit the real .env.test: it must point at a DEDICATED test database
# (the integration suite truncates and reseeds tables).
#
# SECURITY NOTE (2026-07-19 audit): the previous .env.test was tracked in git
# with a live staging credential. That file has been untracked; the exposed
# database password must be rotated (it remains in git history).

NODE_ENV=test
PORT=3001

# Dedicated test database — never production, never a shared staging schema.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/YOUR_TEST_DB?pgbouncer=true&connection_limit=10&pool_timeout=20"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/YOUR_TEST_DB"

# Any ≥32-char random string; used only to sign test JWTs.
JWT_SECRET=change-me-to-a-random-32-plus-character-string

FRONTEND_URL="http://localhost:5173"
LOG_LEVEL=error

# Mock values are fine — integration tests never call Supabase for real.
SUPABASE_URL="https://mock.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=mock-service-role-key
SUPABASE_STORAGE_BUCKET="test-bucket"
