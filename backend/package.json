{
  "name": "KANAKU-backend",
  "version": "1.0.0",
  "description": "Backend API for KANAKU with TypeScript, Express, Prisma, JWT, Socket.IO",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "worker": "ts-node-dev --respawn --transpile-only src/worker.ts",
    "generate:prisma": "prisma generate",
    "db:test:reset": "node ../quality/diagnostics/backend/test-db.mjs",
    "ensure:cloud-sync-schema": "node ./scripts/ensure-cloud-sync-schema.cjs",
    "ensure:db-integrity": "node ./scripts/ensure-db-integrity.cjs",
    "backfill:user-settings": "node ./scripts/backfill-user-settings.cjs",
    "backfill:profiles-from-user": "node ./scripts/backfill-profiles-from-user.cjs",
    "demo:reset-users": "node ./scripts/reset-demo-users.cjs",
    "measure:auth": "node ./scripts/measure-auth-distribution.cjs",
    "migrate:supabase-auth": "node ./scripts/migrate-users-to-supabase-auth.cjs",
    "seed:demo": "node ./scripts/seed-production-roles.cjs && node ./scripts/seed-mock-data.cjs",
    "seed:test": "node ./scripts/seed-test-users.cjs",
    "seed:all": "npm run seed:demo && npm run seed:test",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "test": "jest",
    "test:smoke": "jest --runInBand tests/integration/smoke.test.ts",
    "test:sanity": "jest --runInBand tests/integration/sanity.test.ts",
    "test:regression": "jest --runInBand tests/integration/regression.test.ts",
    "test:unit": "jest --runInBand tests/integration/auth.test.ts tests/integration/accounts.test.ts tests/integration/transactions.test.ts tests/integration/goals.test.ts tests/integration/loans.test.ts tests/integration/dashboard.test.ts tests/integration/investments.test.ts tests/integration/notifications.test.ts tests/integration/settings.test.ts tests/integration/friends-groups.test.ts tests/integration/todos.test.ts",
    "test:security": "jest --runInBand tests/integration/security.test.ts tests/integration/ai-security.test.ts tests/integration/bills-security.test.ts",
    "test:ai:security": "jest --runInBand tests/integration/ai-security.test.ts",
    "test:security:critical": "jest --runInBand tests/integration/security.test.ts tests/integration/transactions.test.ts tests/integration/bills-security.test.ts",
    "test:all": "jest --runInBand",
    "test:coverage": "jest --coverage",
    "qa:seed-admin": "node ./scripts/seed-admin-feature-data.cjs",
    "qa:matrix": "powershell -ExecutionPolicy Bypass -File ./scripts/run-feature-matrix.ps1",
    "qa:test-features": "npm run qa:seed-admin && powershell -ExecutionPolicy Bypass -File ./scripts/run-feature-matrix-with-server.ps1",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts --report-unused-disable-directives --max-warnings 587",
    "lint:fix": "eslint src --ext .ts --fix",
    "schemas:scaffold": "powershell -ExecutionPolicy Bypass -File scripts/scaffold-feature-schemas.ps1",
    "db:generate": "prisma generate",
    "type-check": "tsc --noEmit",
    "db:deploy": "node ./scripts/deploy-migrate.mjs",
    "db:status": "prisma migrate status --schema ./prisma/schema.prisma",
    "db:baseline": "node ./scripts/db-baseline.mjs",
    "clean:mock-users": "node ./scripts/remove-non-advisor-mock-users.cjs"
  },
  "keywords": [
    "KANAKU",
    "expense-tracker",
    "typescript",
    "express",
    "prisma",
    "jwt",
    "socket.io"
  ],
  "author": "Your Name",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "@google/generative-ai": "^0.24.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.9.1",
    "@sendgrid/mail": "^8.1.5",
    "@sentry/node": "^10.71.0",
    "@supabase/supabase-js": "^2.110.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "file-type": "^22.0.2",
    "firebase-admin": "^14.3.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.10",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "node-cron": "^4.5.0",
    "nodemailer": "^9.0.5",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "prisma": "7.10.0",
    "prom-client": "^15.1.3",
    "rotating-file-stream": "^3.2.10",
    "sharp": "^0.35.3",
    "socket.io": "^4.7.4",
    "sqlite3": "^6.0.1",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.23.12",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "uuid": "^14.0.2",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@kanaku/shared": "*",
    "@prisma/internals": "^7.10.0",
    "@types/cors": "^2.8.17",
    "@types/dotenv": "^8.2.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.3.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.9.1",
    "jest": "^30.4.2",
    "jest-environment-node": "^30.4.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "tar": "^7.5.16",
    "socket.io-parser": "^4.2.6",
    "form-data": "^4.0.6",
    "minimatch": "^10.2.4",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^10.2.4"
    },
    "flatted": "^3.4.2",
    "picomatch": "^2.3.2 || ^4.0.4",
    "defu": "^6.1.5",
    "effect": "^3.20.0",
    "qs": "^6.15.2",
    "@xmldom/xmldom": "^0.9.10",
    "ws": "^8.21.0",
    "follow-redirects": "^1.16.0",
    "undici": "^6.24.0",
    "handlebars": "^4.7.9",
    "ajv": "^6.14.0",
    "esbuild": "^0.28.1",
    "ip-address": "^10.2.0",
    "js-yaml": "^4.1.2",
    "yaml": "^2.8.3 || ^1.10.3",
    "protobufjs": "^7.6.3 || ^8.6.0",
    "@babel/core": "^7.29.6",
    "@tootallnate/once": "^2.0.1 || ^3.0.1",
    "smol-toml": "^1.6.1",
    "nodemailer": "^9.0.5",
    "axios": "^1.18.0",
    "postcss": "^8.5.15",
    "uuid": "^14.0.2",
    "file-type": "^22.0.2"
  }
}
