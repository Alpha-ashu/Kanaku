<?xml version="1.0" encoding="utf-8"?>
<!--
  PRODUCTION network policy.

  Cleartext is off everywhere. The localhost/127.0.0.1 exemption that used to live
  here applied to release builds too; it now lives in
  app/src/debug/res/xml/network_security_config.xml, which overrides this file for
  debug builds only.
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
