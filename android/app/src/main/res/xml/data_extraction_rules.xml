<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup / transfer policy (API 31+).

  android:allowBackup="false" already disables this, but the rule sets were empty
  — and an empty <cloud-backup> means "include everything", so the moment backup
  were ever enabled the PIN material and detected-transaction queue would leave
  the device. These exclusions make that safe by construction.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- WebView-backed storage: holds the PIN verifier, salt and the
             encrypted local ledger. Never leaves the device. -->
        <exclude domain="file" path="app_webview" />
        <exclude domain="database" />
        <!-- Capacitor Preferences + the pending SMS transaction queue. -->
        <exclude domain="sharedpref" path="CapacitorStorage.xml" />
        <exclude domain="sharedpref" path="KANAKU_sms_detection.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="app_webview" />
        <exclude domain="database" />
        <exclude domain="sharedpref" path="CapacitorStorage.xml" />
        <exclude domain="sharedpref" path="KANAKU_sms_detection.xml" />
    </device-transfer>
</data-extraction-rules>
