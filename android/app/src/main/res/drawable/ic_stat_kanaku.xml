<!--
  Notification small icon.

  MUST be monochrome. Since Android 5.0 the system treats a notification small
  icon as an ALPHA MASK: every non-transparent pixel is painted solid white (or
  the accent colour) and all colour information is discarded. Passing a full
  colour asset — which is what `R.mipmap.ic_launcher` and the never-created
  `ic_stat_icon_config_sample` placeholder amounted to — renders as a featureless
  white square in the status bar.

  So this is drawn as a single-colour path on a 24dp canvas with generous
  transparent padding, which is what the status bar expects. Shape: a wallet with
  a rupee mark, matching the product without relying on colour to read.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">

    <!-- Wallet body -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M19,5H5C3.9,5 3,5.9 3,7v10c0,1.1 0.9,2 2,2h14c1.1,0 2,-0.9 2,-2V7C21,5.9 20.1,5 19,5zM19,17H5V7h14V17z" />

    <!-- Card slot / clasp -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M17,11h2v2h-2z" />

    <!-- Rupee mark -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M7,8h5v1.1H10.6c0.5,0.3 0.8,0.7 0.95,1.15H12v1.1h-0.45c-0.2,1.15 -1.2,1.9 -2.6,1.9H9.15L11.9,16H10.4l-2.75,-2.9v-1h1.1c0.85,0 1.4,-0.35 1.55,-0.85H7v-1.1h3.25C10.05,9.6 9.5,9.25 8.7,9.25H7V8z" />
</vector>
