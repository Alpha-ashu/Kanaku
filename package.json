{
  "name": "kanaku",
  "private": true,
  "version": "1.0.0",
  "description": "A comprehensive personal finance management platform (npm workspaces monorepo)",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "turbo run build",
    "build:frontend": "npm run build --workspace frontend",
    "build:frontend:android": "npm run --workspace frontend build:android",
    "build:backend": "npm run build --workspace backend",
    "preview": "npm run preview --workspace frontend",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "docs:modules": "node scripts/gen-module-readmes.mjs",
    "docs:frontend": "node scripts/gen-frontend-readmes.mjs",
    "docs:catalogs": "node scripts/gen-catalogs.mjs",
    "docs:endpoints": "node scripts/gen-endpoint-docs.mjs",
    "test": "turbo run test",
    "test:backend": "npm run test --workspace backend",
    "e2e:seed": "node scripts/seed_e2e_users.cjs && node quality/e2e/seed-test-users.cjs",
    "pretest:e2e": "npm run e2e:seed",
    "test:e2e": "playwright test",
    "test:api": "playwright test -c quality/api/e2e/playwright.api.config.ts",
    "db:migrate": "cd backend && npx prisma migrate dev",
    "db:seed": "cd backend && npx prisma db seed",
    "db:studio": "cd backend && npx prisma studio",
    "db:clean:mock-users": "npm --prefix backend run clean:mock-users",
    "predb:generate": "node -e \"require('fs').mkdirSync('backend/generated/prisma/runtime', { recursive: true })\"",
    "db:generate": "npx prisma generate --schema backend/prisma/schema.prisma",
    "cap:init": "npx cap init",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npx cap sync && npm run cap:fix:spm",
    "cap:sync:android": "npx cap sync android",
    "cap:sync:ios": "npx cap sync ios && npm run cap:fix:spm",
    "cap:fix:spm": "node scripts/normalize-spm-paths.mjs",
    "assets:icons": "node scripts/gen-app-icons.mjs",
    "cap:doctor": "npx cap doctor",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "mobile:build": "npm run build:frontend && npm run cap:sync",
    "mobile:build:android": "npm run build:frontend:android && npx cap sync android",
    "mobile:build:ios": "npm run build:frontend && npm run cap:sync:ios",
    "mobile:run:android": "npm run mobile:build:android && npx cap run android",
    "mobile:run:ios": "npm run mobile:build:ios && npx cap run ios",
    "mobile:aab:play": "npm run mobile:build:android && cd android && ./gradlew bundleNosmsRelease",
    "mobile:aab:full": "npm run mobile:build:android && cd android && ./gradlew bundleFullRelease",
    "qa:backend:seed": "npm --prefix backend run qa:seed-admin",
    "qa:backend:matrix": "npm --prefix backend run qa:matrix",
    "qa:backend": "npm --prefix backend run qa:test-features",
    "qa:api-report": "node quality/api/runner/run-api-report.mjs",
    "qa:ui-inventory": "node scripts/gen-ui-inventory.mjs",
    "qa:ui-fix": "node scripts/fix-ui-testids.mjs",
    "qa:contract-audit": "node scripts/audit-api-contracts.mjs",
    "qa:contract-enrich": "node scripts/enrich-api-contracts.mjs",
    "qa:contract-enrich-zod": "node scripts/enrich-contracts-from-validation.mjs",
    "qa:contract-finalize": "node scripts/finalize-contract-responses.mjs",
    "qa:admin-capture": "node scripts/qa-admin-capture.mjs",
    "qa:regression": "node scripts/qa-regression-diff.mjs",
    "qa:evidence": "node scripts/qa-evidence-validation.mjs",
    "qa:reports": "npm run qa:ui-inventory && npm run qa:contract-audit",
    "clean": "rimraf frontend/dist backend/dist node_modules/.vite frontend/node_modules/.vite .turbo frontend/.turbo backend/.turbo",
    "clean:mobile": "rimraf android/build android/app/build android/.gradle android/capacitor-cordova-android-plugins/build ios/App/build ios/DerivedData",
    "clean:all": "npm run clean && npm run clean:mobile",
    "postinstall": "node -e \"process.env.VERCEL === '1' || require('child_process').execSync('npm run db:generate', {stdio: 'inherit'});\"",
    "setup": "npm ci && npm run db:generate",
    "dev:full": "node scripts/dev-full.mjs"
  },
  "capacitorPluginsNote": "Capacitor plugins MUST be declared in this file's `dependencies`, not only in frontend/package.json. The Capacitor CLI resolves the native plugin list from the package.json that sits next to capacitor.config.json (this one); anything declared only in a workspace is invisible to `cap sync` and never gets compiled into the android/ios projects. Keep the versions here in sync with frontend/package.json.",
  "dependencies": {
    "@capacitor-community/speech-recognition": "7.0.1",
    "@capacitor/app": "8.1.0",
    "@capacitor/core": "8.4.1",
    "@capacitor/device": "8.0.2",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/local-notifications": "8.2.0",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/push-notifications": "8.1.2",
    "@capacitor/share": "8.0.1",
    "@capacitor/splash-screen": "8.0.1",
    "@capacitor/status-bar": "8.0.2",
    "@capgo/capacitor-native-biometric": "8.6.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.2",
    "@capacitor/cli": "^8.0.2",
    "@capacitor/ios": "^8.4.2",
    "@playwright/test": "^1.61.1",
    "@types/express": "^4.17.21",
    "@vercel/node": "^5.8.22",
    "ajv": "^6.14.0",
    "prisma": "6.19.2",
    "turbo": "^2.10.5",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "@prisma/client": "6.19.2",
    "prisma": "6.19.2",
    "zod": "3.23.8",
    "@vercel/node": {
      "path-to-regexp": "^8.4.2"
    },
    "rollup": "^4.62.0",
    "tar": "^7.5.22",
    "socket.io-parser": "^4.2.7",
    "form-data": "^4.0.6",
    "minimatch": "^10.2.4",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^10.2.4"
    },
    "dompurify": "^3.4.13",
    "flatted": "^3.4.2",
    "picomatch": "^2.3.2 || ^4.0.4",
    "defu": "^6.1.5",
    "effect": "^3.20.0",
    "lodash": "^4.18.0",
    "qs": "^6.15.2",
    "@xmldom/xmldom": "^0.9.10",
    "ws": "^8.21.0",
    "follow-redirects": "^1.16.0",
    "undici": "^7.28.0",
    "handlebars": "^4.7.9",
    "ajv": "^6.14.0",
    "eslint": {
      "ajv": "^6.14.0"
    },
    "@eslint/eslintrc": {
      "ajv": "^6.14.0"
    },
    "@vercel/static-config": {
      "ajv": "^8.18.0"
    },
    "esbuild": "^0.28.1",
    "ip-address": "^10.2.0",
    "js-yaml": "^4.1.2",
    "yaml": "^2.8.3 || ^1.10.3",
    "protobufjs": "^7.6.3 || ^8.6.0",
    "@babel/core": "^7.29.6",
    "@tootallnate/once": "^2.0.1 || ^3.0.1",
    "smol-toml": "^1.6.1",
    "nodemailer": "^9.0.1",
    "axios": "^1.18.0",
    "postcss": "^8.5.26",
    "uuid": "^14.0.0",
    "file-type": "^22.0.1",
    "vite": "8.0.16",
    "@emnapi/core": "1.11.1",
    "@emnapi/runtime": "1.11.1",
    "@emnapi/wasi-threads": "1.2.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "motion": "12.40.0",
    "framer-motion": "12.40.0",
    "motion-dom": "12.40.0",
    "motion-utils": "12.39.0",
    "brace-expansion": "^5.0.9",
    "fast-uri": "^3.1.5",
    "fast-xml-parser": "^5.10.1"
  },
  "pnpm": {
    "overrides": {
      "vite": "8.0.16"
    }
  },
  "packageManager": "npm@11.6.2"
}
